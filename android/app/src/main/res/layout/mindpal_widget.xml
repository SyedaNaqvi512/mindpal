<?xml version="1.0" encoding="utf-8"?>
<!-- MindPal home-screen widget. It shows no journal text: a greeting, five mood
     buttons and a gentle count of writing days. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mindpal_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/widget_logo_description"
            android:src="@drawable/mindpal_widget_logo"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_title"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/widget_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_calm_line"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_write"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/mindpal_widget_pill"
            android:contentDescription="@string/widget_write_description"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/widget_write"
            android:textColor="#FF4A2F73"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_question"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView
            android:id="@+id/widget_mood_1"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/mindpal_widget_chip"
            android:contentDescription="@string/mood_1"
            android:gravity="center"
            android:text="😞"
            android:textSize="22sp"/>

        <TextView
            android:id="@+id/widget_mood_2"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/mindpal_widget_chip"
            android:contentDescription="@string/mood_2"
            android:gravity="center"
            android:text="😕"
            android:textSize="22sp"/>

        <TextView
            android:id="@+id/widget_mood_3"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/mindpal_widget_chip"
            android:contentDescription="@string/mood_3"
            android:gravity="center"
            android:text="😐"
            android:textSize="22sp"/>

        <TextView
            android:id="@+id/widget_mood_4"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/mindpal_widget_chip"
            android:contentDescription="@string/mood_4"
            android:gravity="center"
            android:text="🙂"
            android:textSize="22sp"/>

        <TextView
            android:id="@+id/widget_mood_5"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/mindpal_widget_chip"
            android:contentDescription="@string/mood_5"
            android:gravity="center"
            android:text="😄"
            android:textSize="22sp"/>
    </LinearLayout>
</LinearLayout>
